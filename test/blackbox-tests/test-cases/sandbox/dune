; Tests that pass on Windows

(cram
 (applies_to sandboxing.t sandbox-events.t corrections-directory-deps.t)
 (alias runtest-windows))

(cram
 (applies_to sandbox-symlink-windows.t)
 (enabled_if
  (= %{os_type} Win32))
 (alias runtest-windows))

