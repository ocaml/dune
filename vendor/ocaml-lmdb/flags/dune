(rule
 (enabled_if
  (<> %{os_type} "Win32"))
 (target c_flags.sexp)
 (action
  (write-file %{target} "()\n")))

(rule
 (enabled_if
  (and
   (= %{os_type} "Win32")
   (= %{ocaml-config:ccomp_type} "msvc")))
 (target c_flags.sexp)
 (action
  (write-file
   %{target}
   "(\"/wd5287\" \"/wd4333\" \"/wd4172\" \"/wd4146\" \"/wd4244\")\n")))

(rule
 (enabled_if
  (and
   (= %{os_type} "Win32")
   (<> %{ocaml-config:ccomp_type} "msvc")))
 (target c_flags.sexp)
 (action
  (with-stdout-to
   %{target}
   (echo
    "(-Wno-return-local-addr"
    -Wno-unused-label
    "-Wno-unused-but-set-variable)\n"))))
